rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function admin() { return request.auth != null && request.auth.token.get('admin', false) == true; }
    function member() {
      return request.auth != null
        && exists(/databases/$(database)/documents/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/members/$(request.auth.uid)).data.get('active',true) != false
        && get(/databases/$(database)/documents/members/$(request.auth.uid)).data.get('sessionKey','') != ''
        && request.auth.token.get('memberKey','') == get(/databases/$(database)/documents/members/$(request.auth.uid)).data.sessionKey;
    }
    function online(roomId) { return get(/databases/$(database)/documents/rooms/$(roomId)).data.get('onlineVersion',0)==1; }
    match /members/{id} {
      allow read: if admin() || (member() && request.auth.uid==id);
      allow write: if admin();
    }
    match /admin/{id} {
      allow read, write: if admin();
    }
    match /config/{id} { allow read, write: if admin(); }
    match /rooms/{roomId} {
      allow read: if admin() || (member() && resource.data.get('onlineVersion',0)==1);
      allow create: if admin() && request.resource.data.onlineVersion==1 && request.resource.data.status=='lobby';
      // Game writes go through the validated server transaction; no player can edit state directly.
      allow update, delete: if admin() && resource.data.status!='playing';
      match /deals/{id} {
        allow read: if member() && online(roomId) && request.auth.uid==id;
        allow write: if false;
      }
      match /hands/{id} {
        allow read: if member() && online(roomId) && request.auth.uid==id;
        allow write: if false;
      }
      match /rounds/{round} {
        allow read: if admin() || (member() && online(roomId));
        allow write: if false;
      }
      match /history/{id} { allow read: if admin(); allow write: if false; }
      match /chat/{id} {
        allow read: if member() && online(roomId);
        allow create: if member() && online(roomId)
          && request.resource.data.keys().hasOnly(['uid','name','avatar','text','timestamp'])
          && request.resource.data.uid==request.auth.uid
          && request.resource.data.name==get(/databases/$(database)/documents/members/$(request.auth.uid)).data.name
          && request.resource.data.avatar==get(/databases/$(database)/documents/members/$(request.auth.uid)).data.avatar
          && request.resource.data.text is string && request.resource.data.text.size()>0 && request.resource.data.text.size()<=200
          && request.resource.data.timestamp==request.time;
        allow update, delete: if false;
      }
    }
    // _credentials, _authLimits, settlements and any unknown paths are server-only.
  }
}
